generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// LAND PARCEL DETECTION MODELS
// ============================================

// CORE MODELS
// ============================================

model Parcel {
  id          String  @id @default(uuid())
  geometry    String // JSON stringified [[x,y], ...]
  label       String
  ownerName   String?
  status      String  @default("AVAILABLE") // SOLD, AVAILABLE
  areaSqm     Float
  pricePerSqm Float
  totalPrice  Float

  // Relations
  terrainId String?
  terrain   Terrain? @relation(fields: [terrainId], references: [id], onDelete: Cascade)

  customerId String? // The buyer/owner
  customer   Customer? @relation("PurchasedParcels", fields: [customerId], references: [id], onDelete: SetNull)

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  documents ParcelDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Merged Project and Terrain
model Terrain {
  id           String  @id @default(uuid())
  name         String
  address      String?
  latitude     Float?
  longitude    Float?
  mapReference String?

  // Project/Image Data
  imagePath   String?
  imageData   Bytes?
  scaleFactor Float?
  refLineData String? // JSON for reference line

  areaSize Float?
  areaUnit String  @default("sqm")
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  parcels   Parcel[]
  documents TerrainDocument[]
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  idNumber  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  purchasedParcels Parcel[]           @relation("PurchasedParcels")
  contracts        Contract[]
  documents        CustomerDocument[]
}

model Contract {
  id             String   @id @default(uuid())
  contractNumber String?
  terms          String?
  notes          String?
  saleAmount     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  parcels   Parcel[]
  documents ContractDocument[]
}

model Document {
  id            String    @id @default(uuid())
  name          String
  filePath      String?
  fileData      Bytes?
  googleDriveId String?
  mimeType      String?
  type          String    @default("other")
  sizeBytes     Int?
  thumbnailUrl  String?
  uploadedAt    DateTime?
  createdAt     DateTime  @default(now())
  isLinked      Boolean   @default(false)

  // Relations
  terrains  TerrainDocument[]
  customers CustomerDocument[]
  contracts ContractDocument[]
  parcels   ParcelDocument[]
}

model AppSetting {
  key   String @id
  value String
}

// ============================================
// N8N WORKFLOW INTEGRATION
// ============================================

model WorkflowLog {
  id           String    @id @default(uuid())
  workflowId   String
  workflowName String?
  executionId  String?
  status       String    @default("pending")
  inputData    String?
  outputData   String?
  errorMessage String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
}

model ImageProcessingQueue {
  id          String    @id @default(uuid())
  terrainId   String? // Renamed from projectId to match new schema
  imageData   String
  status      String    @default("pending")
  resultData  String?
  webhookUrl  String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

// ============================================
// DOCUMENT LINKING TABLES
// ============================================

model TerrainDocument {
  terrainId  String
  documentId String
  terrain    Terrain  @relation(fields: [terrainId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([terrainId, documentId])
}

model CustomerDocument {
  customerId String
  documentId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([customerId, documentId])
}

model ContractDocument {
  contractId String
  documentId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([contractId, documentId])
}

model ParcelDocument {
  parcelId   String
  documentId String
  parcel     Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([parcelId, documentId])
}
